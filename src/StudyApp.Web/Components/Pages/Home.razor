@page "/"
@inject ReviewService ReviewService
@inject MaterialService MaterialService
@inject ProgressService ProgressService
@inject StudyPlanService StudyPlanService
@using StudyApp.Core.Planning

<PageTitle>StudyApp — Home</PageTitle>

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
    <h1 class="mb-0">Today</h1>
    <a href="how-it-works" class="small">How review &amp; mastery work</a>
</div>

@if (_summary is null)
{
    <p><em>Loading…</em></p>
}
else if (_summary.Courses.Count == 0)
{
    <div class="text-center py-5">
        <p class="display-6">Welcome to StudyApp 👋</p>
        <p class="lead">Create your first course, add a deck, and paste in some flashcards.</p>
        <a class="btn btn-primary btn-lg" href="courses">Create your first course</a>
    </div>
}
else
{
    @if (_summary.HasAnythingToStudy)
    {
        <div class="mb-4">
            <a class="btn btn-primary btn-lg" href="review">
                ▶ Start review
                <span class="badge text-bg-light ms-2">@(_summary.TotalDue + _summary.TotalNew)</span>
            </a>
        </div>
    }
    else
    {
        <div class="alert alert-success">
            🎉 <strong>All caught up!</strong>&nbsp;
            @if (_summary.TotalDueTomorrow > 0)
            {
                <span> @_summary.TotalDueTomorrow card@(_summary.TotalDueTomorrow == 1 ? " is" : "s are") due tomorrow — see you then.</span>
            }
            else
            {
                <span> Nothing scheduled for tomorrow yet. Add more cards from your <a href="courses">courses</a>.</span>
            }
        </div>
    }

    @if (_upcomingAssignments.Count > 0)
    {
        <h2 class="h5 mt-4 mb-2">Upcoming assignments</h2>
        <div class="list-group mb-4">
            @foreach (var a in _upcomingAssignments)
            {
                <a href="courses/@a.CourseId" class="list-group-item list-group-item-action">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <span>
                            <span class="fw-semibold">@a.Title</span>
                            <span class="text-muted small">— @a.Course?.Name</span>
                        </span>
                        <span class="badge @DueBadgeClass(a.DueDate!.Value)">@DueLabel(a.DueDate!.Value)</span>
                    </div>
                    @if (_assignmentPlans.TryGetValue(a.Id, out var plan))
                    {
                        @* The map knows what this assignment assesses, so this is a specific
                           statement about that assignment rather than a course-wide guess. *@
                        <div class="small mt-1">
                            @if (plan.TopicsNeedingCards > 0)
                            {
                                <span class="badge text-bg-danger me-1">
                                    @plan.TopicsNeedingCards topic@(plan.TopicsNeedingCards == 1 ? "" : "s") with no cards
                                </span>
                            }
                            @if (plan.TopicsNeedingReview > 0)
                            {
                                <span class="badge text-bg-warning me-1">
                                    @plan.CardsNeedingWork card@(plan.CardsNeedingWork == 1 ? "" : "s") to review
                                </span>
                            }
                            @if (plan.TopicsReady > 0)
                            {
                                <span class="badge text-bg-success me-1">@plan.TopicsReady ready</span>
                            }
                            @if (plan.Gaps.Any())
                            {
                                <span class="text-muted">
                                    Start with @string.Join(", ", plan.Gaps.Take(3).Select(g => g.Topic.Name))@(plan.TopicsNeedingCards > 3 ? "…" : "")
                                </span>
                            }
                        </div>
                    }
                    else if (_assignmentForecasts.TryGetValue(a.Id, out var forecast) && forecast.AlreadyDurable + forecast.WillLapseBeforeTarget > 0)
                    {
                        @* No map yet for this course, so fall back to the course-wide projection. *@
                        <div class="text-muted small mt-1">
                            If you keep up reviews, ~@Pct(forecast.ProjectedMastery) of @a.Course?.Name will likely be
                            durable by then (@forecast.WillLapseBeforeTarget card@(forecast.WillLapseBeforeTarget == 1 ? "" : "s") still need review before).
                        </div>
                    }
                </a>
            }
        </div>
    }

    <div class="list-group">
        @foreach (var course in _summary.Courses)
        {
            <div class="list-group-item d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div class="flex-grow-1" style="min-width: 10rem;">
                    <div class="d-flex align-items-center gap-2">
                        <span class="course-dot" style="background:@course.Color"></span>
                        <a href="courses/@course.CourseId" class="fw-semibold text-decoration-none">@course.Name</a>
                        @if (_courseProgress.TryGetValue(course.CourseId, out var cp) && cp.Total > 0)
                        {
                            <span class="text-muted small">@Pct(cp.Mastery) mastery</span>
                        }
                    </div>
                    @if (_courseProgress.TryGetValue(course.CourseId, out var barReport) && barReport.Total > 0)
                    {
                        <div class="mt-1" style="max-width: 14rem;">
                            <ProgressBar Report="barReport" />
                        </div>
                    }
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span title="Due today">
                        @if (course.Due > 0)
                        {
                            <span class="badge text-bg-danger">@course.Due due</span>
                        }
                        else
                        {
                            <span class="text-muted small">0 due</span>
                        }
                    </span>
                    <span title="New cards">
                        @if (course.New > 0)
                        {
                            <span class="badge text-bg-primary">@course.New new</span>
                        }
                    </span>
                    <span class="text-muted small" title="Due tomorrow">@course.DueTomorrow tomorrow</span>
                    @if (course.Total > 0)
                    {
                        <a class="btn btn-sm btn-outline-primary" href="review/course/@course.CourseId">Review</a>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private HomeSummary? _summary;
    private List<Material> _upcomingAssignments = [];
    private Dictionary<Guid, ProgressReport> _courseProgress = [];
    private Dictionary<Guid, ProgressForecast> _assignmentForecasts = [];
    private Dictionary<Guid, StudyPlan> _assignmentPlans = [];

    protected override async Task OnInitializedAsync()
    {
        _summary = await ReviewService.GetHomeSummaryAsync();
        _upcomingAssignments = await MaterialService.GetUpcomingAssignmentsAsync();

        // Small sets (courses and upcoming assignments are both capped low), so a query per
        // item is simpler than a bespoke batch query and costs nothing noticeable here.
        foreach (var course in _summary.Courses)
            _courseProgress[course.CourseId] = await ProgressService.GetCourseProgressAsync(course.CourseId);

        foreach (var assignment in _upcomingAssignments.Where(a => a.DueDate is not null))
        {
            // Prefer the map-derived plan; the course-wide forecast is the fallback for a course
            // that hasn't been mapped yet.
            if (await StudyPlanService.GetForAssignmentAsync(assignment.Id) is { } plan)
                _assignmentPlans[assignment.Id] = plan;
            else
                _assignmentForecasts[assignment.Id] =
                    await ProgressService.GetCourseForecastAsync(assignment.CourseId, assignment.DueDate!.Value);
        }
    }

    private static string Pct(double fraction) => $"{fraction * 100:0}%";

    private static string DueLabel(DateTime due)
    {
        var days = (due.Date - DateTime.Today).Days;
        return days switch
        {
            < 0 => $"{-days}d overdue",
            0 => "due today",
            1 => "due tomorrow",
            _ => $"due in {days}d",
        };
    }

    private static string DueBadgeClass(DateTime due)
    {
        var days = (due.Date - DateTime.Today).Days;
        return days switch
        {
            <= 0 => "text-bg-danger",
            <= 3 => "text-bg-warning",
            _ => "text-bg-secondary",
        };
    }
}
