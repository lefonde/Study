        catch (InvalidOperationException ex)
        {
            // Thrown when the selection exceeds MaxFilesPerUpload. Say so plainly rather than
            // silently uploading a subset.
            _selectedFiles = [];
            _uploadError = ex.Message;
        }
    }

    /// <summary>
    /// Uploads the batch one file at a time, reporting progress as it goes.
    ///
    /// A failure part-way keeps everything already stored rather than rolling back: re-selecting
    /// twenty files because the nineteenth was malformed would be its own punishment, and the
    /// materials list shows exactly what landed.
    /// </summary>
    private async Task UploadAsync()
    {
        if (_selectedFiles.Count == 0)
            return;

        _uploading = true;
        _uploadError = null;
        _uploadedSoFar = 0;
        var failures = new List<string>();

        try
        {
            foreach (var file in _selectedFiles)
            {
                try
                {
                    await using var stream = file.OpenReadStream(MaxFileSizeBytes);
                    await MaterialService.UploadAsync(
                        Id, file.Name, file.ContentType, stream,
                        _uploadKind, _uploadUnitId, _uploadDueDate);
                    _uploadedSoFar++;
                }
                catch (Exception ex)
                {
                    failures.Add($"{file.Name}: {ex.Message}");
                }
                StateHasChanged();
            }

            _selectedFiles = [];
            if (failures.Count > 0)
                _uploadError = $"{failures.Count} file(s) failed — {string.Join("; ", failures.Take(3))}";

            await ReloadAsync();
        }
        finally
        {
            _uploading = false;
        }
    }

    // --- Solutions and their reviews ---

    /// <summary>
    /// Uploads an answer against one assignment, then queues its ingestion straight away — a
    /// solution is only useful once it can be read, and making the user press Ingest as a separate
    /// step just leaves it sitting there.
    /// </summary>
    private async Task UploadSolutionAsync(Guid assignmentId, InputFileChangeEventArgs e)
    {
        _solutionError = null;
        _uploading = true;
        try
        {
            var file = e.File;
            await using var stream = file.OpenReadStream(MaxFileSizeBytes);
            var material = await MaterialService.UploadAsync(
                Id, file.Name, file.ContentType, stream,
                MaterialKind.Submission, null, null, submissionForId: assignmentId);

            if (AiOptions.IsConfigured)
                await AiJobService.QueueAsync(material.Id, JobKind.Ingest);

            _uploadingSolutionFor = null;
        }
        catch (Exception ex)
        {
            _solutionError = ex.Message;
        }
        finally
        {
            _uploading = false;
        }
        await ReloadAsync();
    }

