    private IEnumerable<Material> UpcomingAssignments =>
        _materials.Where(m => m.DueDate is not null && m.SubmittedAt is null)
                  .OrderBy(m => m.DueDate);

    /// <summary>
    /// Prerequisite ids for the JS to join up, taken from the graph rather than the topic so
    /// dismissed topics are already bypassed — otherwise a line would point at a card that isn't
    /// on screen.
    /// </summary>
    private string RequiresAttribute(CourseTopic topic) =>
        string.Join(",", _progression.PrerequisitesOf(topic.Id));

    /// <summary>
    /// An assignment sits after the deepest stage it assesses: that is the point in the course by
    /// which everything it tests has been reached.
    /// </summary>
    private IEnumerable<Material> MilestonesAfterStage(int stageIndex) =>
        _materials
            .Where(m => m.DueDate is not null
                        && _assignmentPlans.TryGetValue(m.Id, out var plan)
                        && DeepestStage(plan) == stageIndex)
            .OrderBy(m => m.DueDate);

    private int DeepestStage(StudyPlan plan) =>
        plan.Assessed
            .Select(i => _progression.StageByTopic.GetValueOrDefault(i.Topic.Id, 0))
            .DefaultIfEmpty(0)
            .Max();

    /// <summary>
    /// Dims everything the selected assignment doesn't touch, so "which subjects are related to
    /// this deadline" is answered by looking rather than by reading.
    /// </summary>
    private string NodeStateClass(CourseTopic topic)
    {
        var uncovered = CardsFor(topic.Id) == 0 ? " uncovered" : "";

        if (_selectedAssignmentId is not { } id || !_assignmentPlans.TryGetValue(id, out var plan))
            return uncovered;

        var item = plan.Items.FirstOrDefault(i => i.Topic.Id == topic.Id);
        return item switch
        {
            null => uncovered + " dimmed",
            { IsFoundation: true } => uncovered + " foundation",
            _ => uncovered + " assessed",
        };
    }

    private static string DueLabel(DateTime due)
    {
        var days = (int)Math.Ceiling((due.Date - DateTime.Now.Date).TotalDays);
        return days switch
        {
            < 0 => $"{-days}d overdue",
            0 => "due today",
            1 => "due tomorrow",
            _ => $"in {days}d",
        };
    }

