@page "/courses/{Id:guid}"
@implements IAsyncDisposable
@inject CourseService CourseService
@inject DeckService DeckService
@inject CourseUnitService UnitService
@inject MaterialService MaterialService
@inject ProgressService ProgressService
@inject AiOptions AiOptions
@inject AiJobService AiJobService
@inject CourseMapService CourseMapService
@inject CoverageService CoverageService
@inject SubmissionReviewService SubmissionReviewService
@inject StudyPlanService StudyPlanService
@using StudyApp.Core.Planning
@inject SuggestionService SuggestionService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>StudyApp — @(_course?.Name ?? "Course")</PageTitle>

@if (_course is null)
{
    <p><em>Loading…</em></p>
}
else
{
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="courses">Courses</a></li>
            <li class="breadcrumb-item active">@_course.Name</li>
        </ol>
    </nav>

    <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
        @if (_editingHeader)
        {
            <input type="color" class="form-control form-control-color" @bind="_editColor" />
            <input class="form-control w-auto" @bind="_editName" />
            <button class="btn btn-sm btn-primary" @onclick="SaveHeaderAsync">Save</button>
            <button class="btn btn-sm btn-secondary" @onclick="() => _editingHeader = false">Cancel</button>
        }
        else
        {
            <span class="course-dot" style="background:@_course.Color"></span>
            <h1 class="mb-0 me-2">@_course.Name</h1>
            <button class="btn btn-sm btn-outline-secondary" @onclick="StartHeaderEdit">✏ Edit</button>
        }
    </div>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "decks" ? "active" : "")" @onclick=@(() => _activeTab = "decks")>
                Decks
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "structure" ? "active" : "")" @onclick=@(() => _activeTab = "structure")>
                Structure
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "materials" ? "active" : "")" @onclick=@(() => _activeTab = "materials")>
                Materials
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "map" ? "active" : "")" @onclick=@(() => _activeTab = "map")>
                Map
                @if (_pendingRevision is { } rev && rev.Proposals.Any(p => p.Status == ProposalStatus.Pending))
                {
                    <span class="badge text-bg-warning ms-1">
                        @rev.Proposals.Count(p => p.Status == ProposalStatus.Pending)
                    </span>
                }
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "inbox" ? "active" : "")" @onclick=@(() => _activeTab = "inbox")>
                Inbox
                @if (_suggestions.Count > 0)
                {
                    <span class="badge text-bg-danger ms-1">@_suggestions.Count</span>
                }
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "notes" ? "active" : "")" @onclick=@(() => _activeTab = "notes")>
                Notes
            </button>
        </li>
    </ul>

    @if (_activeTab == "decks")
    {
        @if (_courseProgress is { Total: > 0 } cp)
        {
            <div class="card mb-3">
                <div class="card-body py-2">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-1">
                        <span class="small text-muted">Course mastery</span>
                        <span class="d-flex align-items-center gap-2">
                            <span class="fw-semibold">@Pct(cp.Mastery)</span>
                            <a href="how-it-works#progress" class="small">How is this calculated?</a>
                        </span>
                    </div>
                    <ProgressBar Report="cp" />
                </div>
            </div>
        }

        <div class="input-group mb-3" style="max-width: 30rem;">
            <input class="form-control" placeholder="New deck name, e.g. Chapter 3"
                   @bind="_newDeckName" @bind:event="oninput" />
            <button class="btn btn-primary" disabled="@string.IsNullOrWhiteSpace(_newDeckName)" @onclick="CreateDeckAsync">
                Add deck
            </button>
        </div>

        @if (_deckStats.Count == 0)
        {
            <p class="text-muted">No decks yet — create one above, then paste cards into it.</p>
        }
        else
        {
            <div class="list-group">
                @foreach (var deck in _deckStats)
                {
                    <div class="list-group-item d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <div class="flex-grow-1" style="min-width: 12rem;">
                            <a href="decks/@deck.DeckId" class="fw-semibold text-decoration-none">@deck.Name</a>
                            @if (DeckProgressFor(deck.DeckId) is { Total: > 0 } dp)
                            {
                                <div class="mt-1" style="max-width: 16rem;">
                                    <ProgressBar Report="dp" />
                                </div>
                            }
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <select class="form-select form-select-sm" style="width: auto;"
                                    title="Unit this deck counts toward"
                                    @onchange="e => SetDeckUnitAsync(deck.DeckId, (string?)e.Value)">
                                <option value="" selected="@(deck.UnitId is null)">— no unit —</option>
                                @foreach (var u in _allUnits)
                                {
                                    <option value="@u.Id" selected="@(deck.UnitId == u.Id)">@UnitPath(u.Id)</option>
                                }
                            </select>
                            <span class="text-muted small">@deck.Total card@(deck.Total == 1 ? "" : "s")</span>
                            @if (deck.Due > 0)
                            {
                                <span class="badge text-bg-danger">@deck.Due due</span>
                            }
                            @if (deck.New > 0)
                            {
                                <span class="badge text-bg-primary">@deck.New new</span>
                            }
                            @if (deck.Due + deck.New > 0)
                            {
                                <a class="btn btn-sm btn-outline-primary" href="review/deck/@deck.DeckId">Review</a>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
    else if (_activeTab == "structure")
    {
        <div class="alert alert-light border d-flex align-items-center justify-content-between mb-3">
            <span>
                <strong>Currently studying:</strong>
                @(_course.CurrentUnitId is { } cur ? UnitPath(cur) : "Not set — pick a chapter or lesson below")
            </span>
            @if (_course.CurrentUnitId is not null)
            {
                <button class="btn btn-sm btn-outline-secondary" @onclick="ClearPositionAsync">Clear</button>
            }
        </div>

        <div class="input-group mb-3" style="max-width: 30rem;">
            <input class="form-control" placeholder="New chapter title" @bind="_newChapterTitle" @bind:event="oninput" />
            <button class="btn btn-primary" disabled="@string.IsNullOrWhiteSpace(_newChapterTitle)" @onclick="AddChapterAsync">
                Add chapter
            </button>
        </div>

        @if (_chapters.Count == 0)
        {
            <p class="text-muted">No chapters yet — add your syllabus structure above.</p>
        }
        else
        {
            <div class="list-group">
                @foreach (var chapter in _chapters)
                {
                    <div class="list-group-item">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                            @if (_renamingUnitId == chapter.Id)
                            {
                                <input class="form-control w-auto" @bind="_renameDraft" @bind:event="oninput" />
                                <div class="d-flex gap-1">
                                    <button class="btn btn-sm btn-primary" @onclick="SaveRenameAsync">Save</button>
                                    <button class="btn btn-sm btn-secondary" @onclick="() => _renamingUnitId = null">Cancel</button>
                                </div>
                            }
                            else
                            {
                                <span class="fw-semibold">
                                    @chapter.Title
                                    @if (_course.CurrentUnitId == chapter.Id)
                                    {
                                        <span class="badge text-bg-success ms-1">you are here</span>
                                    }
                                    @if (UnitProgressFor(chapter.Id) is { Total: > 0 } chapterProgress)
                                    {
                                        <span class="badge text-bg-light border ms-1" title="Mastery across this chapter's cards">
                                            @Pct(chapterProgress.Mastery) mastery
                                        </span>
                                    }
                                </span>
                                <div class="d-flex gap-1">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => SetPositionAsync(chapter.Id)">Set as position</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => StartRename(chapter)">✏</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteUnitAsync(chapter.Id)">✕</button>
                                </div>
                            }
                        </div>

                        <ul class="list-unstyled ms-4 mt-2 mb-2">
                            @foreach (var lesson in ChildrenOf(chapter.Id))
                            {
                                <li class="d-flex align-items-center justify-content-between flex-wrap gap-2 py-1 border-top">
                                    @if (_renamingUnitId == lesson.Id)
                                    {
                                        <input class="form-control w-auto" @bind="_renameDraft" @bind:event="oninput" />
                                        <div class="d-flex gap-1">
                                            <button class="btn btn-sm btn-primary" @onclick="SaveRenameAsync">Save</button>
                                            <button class="btn btn-sm btn-secondary" @onclick="() => _renamingUnitId = null">Cancel</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <span>
                                            @lesson.Title
                                            @if (_course.CurrentUnitId == lesson.Id)
                                            {
                                                <span class="badge text-bg-success ms-1">you are here</span>
                                            }
                                            @if (UnitProgressFor(lesson.Id) is { Total: > 0 } lessonProgress)
                                            {
                                                <span class="badge text-bg-light border ms-1" title="Mastery across this lesson's cards">
                                                    @Pct(lessonProgress.Mastery) mastery
                                                </span>
                                            }
                                        </span>
                                        <div class="d-flex gap-1">
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => SetPositionAsync(lesson.Id)">Set as position</button>
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => StartRename(lesson)">✏</button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteUnitAsync(lesson.Id)">✕</button>
                                        </div>
                                    }
                                </li>
                            }
                        </ul>

                        <div class="input-group ms-4" style="max-width: 26rem;">
                            <input class="form-control form-control-sm" placeholder="New lesson title"
                                   @bind="_newLessonTitles[chapter.Id]" @bind:event="oninput" />
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => AddLessonAsync(chapter.Id)">
                                Add lesson
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else if (_activeTab == "materials")
    {
        @* Wrapper exists so OnAfterRenderAsync has one element to hand KaTeX — an expanded
           assignment plan renders topic names, and those carry LaTeX. *@
        <div @ref="_materialsRef">
        <div class="card mb-3">
            <div class="card-header">Upload material</div>
            <div class="card-body">
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-md-4">
                        <label class="form-label">Files</label>
                        <InputFile class="form-control" multiple OnChange="OnFilesSelected" />
                        <div class="form-text">
                            Select as many as you like — kind and unit apply to the whole batch and
                            can be changed per file afterwards.
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label">Kind</label>
                        @* Submission is not offered here: a solution is uploaded against the
                           assignment it answers, from that assignment's row, since it is
                           meaningless without knowing which questions it answers. *@
                        <select class="form-select" @bind="_uploadKind">
                            @foreach (var kind in Enum.GetValues<MaterialKind>().Where(k => k != MaterialKind.Submission))
                            {
                                <option value="@kind">@kind</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label">Unit (optional)</label>
                        <select class="form-select" @bind="_uploadUnitId">
                            <option value="">— none —</option>
                            @foreach (var u in _allUnits)
                            {
                                <option value="@u.Id">@UnitPath(u.Id)</option>
                            }
                        </select>
                    </div>
                    @if (_uploadKind == MaterialKind.HomeAssignment)
                    {
                        <div class="col-6 col-md-2">
                            <label class="form-label">Due date</label>
                            <input type="date" class="form-control" @bind="_uploadDueDate" />
                        </div>
                    }
                </div>
                @if (_selectedFiles.Count > 0)
                {
                    <div class="mt-3">
                        <div class="small text-muted mb-1">
                            @_selectedFiles.Count file@(_selectedFiles.Count == 1 ? "" : "s") selected —
                            @FormatSize(_selectedFiles.Sum(f => f.Size)) total
                        </div>
                        <ul class="list-unstyled small mb-2">
                            @foreach (var file in _selectedFiles.Take(8))
                            {
                                <li class="text-truncate">@file.Name <span class="text-muted">@FormatSize(file.Size)</span></li>
                            }
                            @if (_selectedFiles.Count > 8)
                            {
                                <li class="text-muted">…and @(_selectedFiles.Count - 8) more</li>
                            }
                        </ul>
                        <button class="btn btn-primary" disabled="@_uploading" @onclick="UploadAsync">
                            @(_uploading
                                ? $"Uploading {_uploadedSoFar}/{_selectedFiles.Count}…"
                                : $"Upload {_selectedFiles.Count} file{(_selectedFiles.Count == 1 ? "" : "s")}")
                        </button>
                    </div>
                }
                @if (_uploadError is not null)
                {
                    <div class="alert alert-danger mt-2 mb-0">@_uploadError</div>
                }
            </div>
        </div>

        @if (!AiOptions.IsConfigured)
        {
            <div class="alert alert-light border">
                AI ingestion and card generation are off — no Anthropic API key is configured.
                Set one up in <a href="settings">Settings</a>.
            </div>
        }
        else if (_pendingIngestion is { MaterialCount: > 0 } pending)
        {
            <div class="card mb-3 border-primary-subtle">
                <div class="card-body py-3">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <div>
                            <div class="fw-semibold">
                                @pending.MaterialCount material@(pending.MaterialCount == 1 ? "" : "s") not yet ingested
                            </div>
                            <div class="text-muted small">
                                @FormatSize(pending.TotalBytes) — estimated
                                <strong>@AiPricing.FormatRange(AiPricing.EstimateIngestion(AiOptions.Model, pending.TotalBytes))</strong>
                                to ingest. Rough: real cost depends on page count, and the exact
                                figure per run appears below once each finishes.
                            </div>
                        </div>
                        @if (_confirmingIngestAll)
                        {
                            <div class="d-flex gap-2">
                                <button class="btn btn-primary" @onclick="IngestAllAsync">
                                    Yes, ingest @pending.MaterialCount
                                </button>
                                <button class="btn btn-outline-secondary" @onclick="() => _confirmingIngestAll = false">
                                    Cancel
                                </button>
                            </div>
                        }
                        else
                        {
                            <button class="btn btn-outline-primary" @onclick="() => _confirmingIngestAll = true">
                                ✨ Ingest all
                            </button>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="card mb-3">
            <div class="card-header d-flex align-items-center justify-content-between">
                <span>What this course is graded on</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleWeightsEditor">
                    @(_editingWeights ? "Close" : "Adjust")
                </button>
            </div>
            @if (_editingWeights)
            {
                <div class="card-body">
                    <p class="text-muted small">
                        How strongly each kind of material signals what actually matters here. Nothing
                        in the material itself reveals this — a course examined by one final and a
                        course graded on weekly assignments can use the same textbook. These weights
                        decide which topics count as core when the course is mapped.
                    </p>
                    @foreach (var weight in _weights)
                    {
                        <div class="row align-items-center g-2 mb-1">
                            <div class="col-5 col-md-3 small">@weight.Kind</div>
                            <div class="col-5 col-md-7">
                                <input type="range" class="form-range" min="0" max="100" step="5"
                                       value="@weight.Weight"
                                       @onchange="e => SetWeight(weight.Kind, e.Value?.ToString())" />
                            </div>
                            <div class="col-2 text-end small text-muted">@weight.Weight</div>
                        </div>
                    }
                    <div class="mt-2 d-flex gap-2">
                        <button class="btn btn-primary btn-sm" @onclick="SaveWeightsAsync">Save</button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="ResetWeights">
                            Reset to defaults
                        </button>
                        @if (_weightsSaved)
                        {
                            <span class="align-self-center text-success small">Saved</span>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="card-body py-2 small text-muted">
                    @string.Join(" · ", _weights.OrderByDescending(w => w.Weight).Take(4)
                        .Select(w => $"{w.Kind} {w.Weight}"))
                </div>
            }
        </div>

        @if (_jobError is not null)
        {
            <div class="alert alert-danger">@_jobError</div>
        }

        @if (_jobs.Count > 0)
        {
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>AI runs</span>
                    <span class="text-muted small">
                        @AiPricing.Format(_spend?.Usd ?? 0) spent on this course
                    </span>
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var job in _jobs)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-start flex-wrap gap-2">
                            <span>
                                <span class="badge @JobBadge(job.Status) me-1">@job.Status</span>
                                <span class="fw-semibold">@(job.Kind == JobKind.Ingest ? "Ingest" : "Generate cards")</span>
                                <span class="text-muted small">— @(job.Material?.Title ?? "—")</span>
                                @if (job.Message is { Length: > 0 })
                                {
                                    <div class="small @(job.Status == JobStatus.Failed ? "text-danger" : "text-muted")">
                                        @job.Message
                                    </div>
                                }
                            </span>
                            <span class="text-muted small text-nowrap">
                                @AiPricing.Format(AiPricing.Estimate(job.Model, job.InputTokens, job.OutputTokens))
                            </span>
                        </li>
                    }
                </ul>
            </div>
            @if (_hasActiveJobs)
            {
                <p class="text-muted small">
                    A run is in progress — it keeps going if you navigate away.
                    <button class="btn btn-sm btn-link p-0 align-baseline" @onclick="ReloadAsync">Refresh</button>
                </p>
            }
        }

        @if (_materials.Count == 0)
        {
            <p class="text-muted">No materials uploaded yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Kind</th>
                            <th>Unit</th>
                            <th>Size</th>
                            <th>Due</th>
                            <th>AI</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_solutionError is { } solutionProblem)
                        {
                            <tr><td colspan="7"><div class="alert alert-danger mb-0">@solutionProblem</div></td></tr>
                        }
                        @foreach (var m in _materials)
                        {
                            <tr>
                                <td class="text-break" dir="auto">
                                    @m.Title
                                    @if (m.SubmissionForId is { } answers)
                                    {
                                        <div class="small text-muted">
                                            ↳ your answer to @(_materials.FirstOrDefault(a => a.Id == answers)?.Title ?? "a deleted assignment")
                                        </div>
                                    }
                                </td>
                                <td><span class="badge text-bg-secondary">@m.Kind</span></td>
                                <td class="small text-muted">@(m.UnitId is { } uid ? UnitPath(uid) : "—")</td>
                                <td class="small text-nowrap">@FormatSize(m.SizeBytes)</td>
                                <td class="small text-nowrap">
                                    @if (m.SubmittedAt is { } handedIn)
                                    {
                                        <span class="badge text-bg-success" title="Handed in — no longer counted as upcoming">
                                            ✓ @handedIn.ToLocalTime().ToString("d MMM")
                                        </span>
                                    }
                                    else
                                    {
                                        @(m.DueDate is { } d ? d.ToString("yyyy-MM-dd") : "—")
                                    }
                                </td>
                                <td class="text-nowrap">
                                    @switch (m.Status)
                                    {
                                        case MaterialStatus.Ingested:
                                            <a class="badge text-bg-success text-decoration-none"
                                               href="materials/@m.Id/extract">Ingested</a>
                                            break;
                                        case MaterialStatus.Failed:
                                            <span class="badge text-bg-danger">Failed</span>
                                            break;
                                        default:
                                            <span class="badge text-bg-light border">Not ingested</span>
                                            break;
                                    }
                                </td>
                                <td class="text-nowrap">
                                    @if (_assignmentPlans.ContainsKey(m.Id))
                                    {
                                        <button class="btn btn-sm btn-outline-primary me-1"
                                                @onclick="() => _expandedPlanId = _expandedPlanId == m.Id ? null : m.Id">
                                            @(_expandedPlanId == m.Id ? "Hide plan" : "📋 Plan")
                                        </button>
                                        <a class="btn btn-sm btn-outline-success me-1"
                                           title="Review only the cards this assignment needs"
                                           href="review/assignment/@m.Id">🎯 Study</a>
                                    }
                                    @if (m.Kind == MaterialKind.HomeAssignment && m.DueDate is not null)
                                    {
                                        <button class="btn btn-sm btn-outline-info me-1"
                                                title="Upload your answer and have it reviewed"
                                                @onclick="() => _uploadingSolutionFor = _uploadingSolutionFor == m.Id ? null : m.Id">
                                            📤 Solution
                                        </button>
                                        <button class="btn btn-sm @(m.SubmittedAt is null ? "btn-outline-secondary" : "btn-secondary") me-1"
                                                title="@(m.SubmittedAt is null ? "Mark handed in — it stops showing as upcoming" : "Reopen — it counts as upcoming again")"
                                                @onclick="() => ToggleSubmittedAsync(m.Id, m.SubmittedAt is null)">
                                            @(m.SubmittedAt is null ? "✓ Submitted" : "↩ Reopen")
                                        </button>
                                    }
                                    @if (m.Kind == MaterialKind.Submission && AiOptions.IsConfigured && m.Status == MaterialStatus.Ingested)
                                    {
                                        <button class="btn btn-sm btn-primary me-1" disabled="@_hasActiveJobs"
                                                @onclick="() => ReviewSolutionAsync(m.Id)">
                                            @(_reviews.ContainsKey(m.Id) ? "🧾 Re-review" : "🧾 Review this")
                                        </button>
                                    }
                                    @if (_reviews.ContainsKey(m.Id))
                                    {
                                        <button class="btn btn-sm btn-outline-primary me-1"
                                                @onclick="() => _expandedReviewId = _expandedReviewId == m.Id ? null : m.Id">
                                            @(_expandedReviewId == m.Id ? "Hide feedback" : "Feedback")
                                        </button>
                                    }
                                    @if (AiOptions.IsConfigured)
                                    {
                                        @if (m.Status == MaterialStatus.Ingested)
                                        {
                                            <button class="btn btn-sm btn-primary me-1"
                                                    @onclick="() => QueueAsync(m.Id, JobKind.GenerateCards)">
                                                ✨ Generate cards
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-primary me-1"
                                                    @onclick="() => QueueAsync(m.Id, JobKind.Ingest)">
                                                Ingest
                                            </button>
                                        }
                                    }
                                    <a class="btn btn-sm btn-outline-secondary me-1" href="materials/@m.Id/file" target="_blank">File</a>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteMaterialAsync(m.Id)">✕</button>
                                </td>
                            </tr>
                            @if (_uploadingSolutionFor == m.Id)
                            {
                                <tr>
                                    <td colspan="7" class="bg-body-tertiary">
                                        <div class="fw-semibold mb-1">Upload your answer to @m.Title</div>
                                        <p class="text-muted small mb-2">
                                            It's read alongside the assignment's own questions and comes back as
                                            per-question feedback. It is deliberately kept out of the course map
                                            and the card glossary, so a wrong answer can't teach the app anything.
                                        </p>
                                        <InputFile class="form-control" style="max-width: 28rem;"
                                                   OnChange="e => UploadSolutionAsync(m.Id, e)" disabled="@_uploading" />
                                        @if (_uploading)
                                        {
                                            <div class="small text-muted mt-1">Uploading…</div>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (_expandedReviewId == m.Id && _reviews.TryGetValue(m.Id, out var review))
                            {
                                <tr>
                                    <td colspan="7" class="bg-body-tertiary">
                                        <div class="fw-semibold mb-1">
                                            Feedback on @m.Title
                                            <span class="text-muted small ms-1">
                                                @review.CountOf(ReviewVerdict.Correct) correct ·
                                                @review.CountOf(ReviewVerdict.Partly) partly ·
                                                @review.CountOf(ReviewVerdict.Incorrect) incorrect ·
                                                @review.CountOf(ReviewVerdict.Missing) missing
                                            </span>
                                        </div>
                                        @* Said plainly, because a per-question verdict list looks a lot like
                                           marking and it hasn't seen the marking scheme. *@
                                        <div class="small text-muted fst-italic mb-2">
                                            Feedback on your work, not a grade — no score is estimated on purpose.
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(review.Summary))
                                        {
                                            <div class="small map-md md-content mb-2" dir="auto">@Md(review.Summary)</div>
                                        }
                                        <ul class="list-unstyled mb-0 small">
                                            @foreach (var finding in review.Findings)
                                            {
                                                <li class="mb-2">
                                                    <span class="badge @VerdictBadge(finding.Verdict) me-1">@finding.Verdict</span>
                                                    <span class="fw-semibold" dir="auto">@finding.Question</span>
                                                    @if (finding.CourseTopicId is { } topicId)
                                                    {
                                                        <span class="badge text-bg-light border ms-1 md-content" dir="auto">
                                                            @MdInline(TopicName(topicId))
                                                        </span>
                                                    }
                                                    <div class="map-md md-content" dir="auto">@Md(finding.Comment)</div>
                                                </li>
                                            }
                                        </ul>
                                        @* The whole reason findings carry a topic: a mistake becomes something
                                           to study rather than something to feel bad about. *@
                                        @if (AiOptions.IsConfigured && review.WeakTopicIds.Any())
                                        {
                                            <button class="btn btn-sm btn-primary mt-1" disabled="@_hasActiveJobs"
                                                    @onclick="() => GenerateForWeakTopicsAsync(review)">
                                                ✨ Generate cards for the @review.WeakTopicIds.Count() topic@(review.WeakTopicIds.Count() == 1 ? "" : "s") you slipped on
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (_expandedPlanId == m.Id && _assignmentPlans.TryGetValue(m.Id, out var plan))
                            {
                                <tr>
                                    <td colspan="7" class="bg-body-tertiary">
                                        <StudyPlanView Plan="plan" Title="@m.Title" AssignmentId="m.Id" />
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
        </div>
    }
    else if (_activeTab == "map")
    {
        @* Wrapper exists so OnAfterRenderAsync has one element to hand KaTeX — topic names,
           summaries and reasons are markdown with LaTeX, same as a card. *@
        <div @ref="_mapRef">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
            <div>
                <div class="fw-semibold">What this course covers</div>
                <div class="text-muted small">
                    The <strong>topics</strong> your course covers — not flashcards. Read from every
                    ingested material and rated by how much the course actually assesses each one.
                </div>
            </div>
            @if (AiOptions.IsConfigured)
            {
                <span class="d-flex gap-2 flex-wrap">
                    <button class="btn btn-outline-primary" disabled="@_hasActiveJobs" @onclick="MapCourseAsync">
                        @(_topics.Count == 0 ? "✨ Map this course" : "✨ Re-map with new material")
                    </button>
                    @if (_topics.Count > 0 && _unlinkedCardCount > 0)
                    {
                        <button class="btn btn-outline-secondary" disabled="@_hasActiveJobs" @onclick="LinkCardsAsync">
                            🔗 Link @_unlinkedCardCount card@(_unlinkedCardCount == 1 ? "" : "s")
                        </button>
                    }
                </span>
            }
        </div>

        @if (_jobError is not null)
        {
            <div class="alert alert-danger">@_jobError</div>
        }

        @* A map run takes a minute or two with nothing to show for it, so say so — otherwise
           the button just greys out and the page looks broken. *@
        @if (_activeMapJob is { } running)
        {
            <div class="alert alert-info d-flex align-items-center gap-2">
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                <span>
                    <strong>@JobLabel(running.Kind) in progress…</strong>
                    This usually takes a minute or two, and keeps running if you navigate away.
                    Results appear here on their own.
                </span>
            </div>
        }
        else if (_lastMapJob is { Status: JobStatus.Failed } failed)
        {
            <div class="alert alert-danger">
                <strong>@JobLabel(failed.Kind) failed.</strong>
                <div class="small mt-1">@failed.Message</div>
            </div>
        }

        @if (_unmappedMaterialCount > 0)
        {
            <div class="alert alert-warning py-2">
                @_unmappedMaterialCount material@(_unmappedMaterialCount == 1 ? " isn't" : "s aren't")
                ingested yet, so the map may be incomplete — ingest from the
                <button class="btn btn-link p-0 align-baseline" @onclick=@(() => _activeTab = "materials")>Materials tab</button>
                first.
            </div>
        }

        @if (_pendingRevision is { } revision && revision.Proposals.Any(p => p.Status == ProposalStatus.Pending))
        {
            var pending = revision.Proposals.Where(p => p.Status == ProposalStatus.Pending).ToList();
            <div class="card mb-4 border-warning">
                <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <span>
                        <strong>@pending.Count proposed change@(pending.Count == 1 ? "" : "s")</strong>
                        @if (!string.IsNullOrWhiteSpace(revision.Summary))
                        {
                            <span class="text-muted small ms-1 md-content" dir="auto">— @MdInline(revision.Summary)</span>
                        }
                    </span>
                    <span class="d-flex gap-2">
                        <button class="btn btn-sm btn-success" @onclick="() => AcceptAllProposalsAsync(revision.Id)">
                            Accept all @pending.Count
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => DiscardRevisionAsync(revision.Id)">
                            Discard
                        </button>
                    </span>
                </div>
                <div class="card-body py-2 small text-muted border-bottom">
                    Accepting updates this <strong>topic list only</strong> — it never creates,
                    edits or deletes a flashcard. Rejecting discards the change.
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var proposal in pending)
                    {
                        <li class="list-group-item">
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                <div class="flex-grow-1" style="min-width: 14rem;">
                                    <span class="badge @ChangeBadge(proposal.Kind) me-1"
                                          title="@ChangeHint(proposal.Kind)">@proposal.Kind</span>
                                    <span class="fw-semibold md-content" dir="auto">@MdInline(proposal.ProposedName)</span>
                                    <span class="badge @ImportanceBadge(proposal.ProposedImportance) ms-1">
                                        @proposal.ProposedImportance
                                    </span>
                                    @if (proposal.Kind != TopicChangeKind.Add && proposal.Topic is { } existing)
                                    {
                                        <span class="text-muted small ms-1">
                                            (was @existing.Importance)
                                        </span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(proposal.ProposedSummary))
                                    {
                                        <div class="small text-muted map-md md-content" dir="auto">@Md(proposal.ProposedSummary)</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(proposal.Reason))
                                    {
                                        <div class="small fst-italic map-md md-content" dir="auto">@Md(proposal.Reason)</div>
                                    }
                                    <div class="small text-muted">@ChangeHint(proposal.Kind)</div>
                                </div>
                                <span class="text-nowrap">
                                    <button class="btn btn-sm btn-success me-1" @onclick="() => AcceptProposalAsync(proposal.Id)">
                                        ✓ Accept
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => RejectProposalAsync(proposal.Id)">
                                        ✕ Reject
                                    </button>
                                </span>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        }

        @if (_blockedReasons.Count > 0)
        {
            <div class="alert alert-secondary">
                <strong>Some changes were refused to protect your decisions:</strong>
                <ul class="mb-0 small mt-1">
                    @foreach (var reason in _blockedReasons.Take(5))
                    {
                        <li dir="auto">@reason</li>
                    }
                </ul>
            </div>
        }

        @if (_topics.Count == 0)
        {
            <div class="card">
                <div class="card-body">
                    <h3 class="h6">No topics yet</h3>
                    <p class="text-muted small mb-2">
                        Mapping reads your ingested materials and works out what the course covers —
                        one entry per topic, rated by how much the course assesses it, with the
                        evidence for that rating. It produces <em>no flashcards</em>; it's what makes
                        the app able to tell you which parts of the course your cards miss.
                    </p>
                    <p class="text-muted small mb-0">
                        @if (!AiOptions.IsConfigured)
                        {
                            <span>Set an Anthropic key in <a href="settings">Settings</a> to map this course.</span>
                        }
                        else if (_materials.Count == 0)
                        {
                            <span>Upload material on the Materials tab first.</span>
                        }
                        else if (_unmappedMaterialCount == _materials.Count)
                        {
                            <span>Ingest your material first — mapping reads the extracts, not the files.</span>
                        }
                        else
                        {
                            <span>Ready — press <strong>Map this course</strong> above.</span>
                        }
                    </p>
                </div>
            </div>
        }
        else
        {
            @* Mapping is step one of four, which is why finishing it can feel like nothing
               happened. Say where you are and what comes next. *@
            <ol class="map-steps small mb-3">
                <li class="done">Map the course — <strong>@_topics.Count topics</strong></li>
                <li class="@(_unlinkedCardCount > 0 ? "now" : "done")">
                    Link your cards to topics
                    @if (_unlinkedCardCount > 0)
                    {
                        <span>— @_unlinkedCardCount waiting</span>
                    }
                </li>
                <li class="@(_gaps.Count > 0 ? "now" : "done")">
                    Fill the gaps
                    @if (_gaps.Count > 0)
                    {
                        <span>— @_gaps.Count topic@(_gaps.Count == 1 ? "" : "s") with no cards</span>
                    }
                </li>
                <li class="@(_gaps.Count == 0 && _unlinkedCardCount == 0 ? "now" : "")">
                    Study, and check the plan before each assignment
                </li>
            </ol>

            <div class="card mb-3">
                <div class="card-body py-2">
                    <div class="row g-2 align-items-center">
                        <div class="col-6 col-md-3">
                            <div class="text-muted small" title="Topics with at least one card">Coverage</div>
                            <div class="fs-5">@Pct(_coverage.Coverage)</div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="text-muted small" title="The number worth acting on">Core covered</div>
                            <div class="fs-5 @(_coverage.UncoveredCoreTopics > 0 ? "text-danger" : "")">
                                @_coverage.CoveredCoreTopics / @_coverage.CoreTopics
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="text-muted small" title="How well you know the cards you have">Mastery</div>
                            <div class="fs-5">@(_courseProgress is { Total: > 0 } mp ? Pct(mp.Mastery) : "—")</div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="text-muted small">Topics</div>
                            <div class="fs-5">@_coverage.TotalTopics</div>
                        </div>
                    </div>
                    <div class="text-muted small mt-1">
                        Coverage and mastery are separate on purpose: low coverage means write more
                        cards, low mastery means study the ones you have.
                        <a href="how-it-works#progress">How mastery is calculated</a>
                    </div>
                </div>
            </div>

            @if (AiOptions.IsConfigured && _gaps.Count > 0)
            {
                <div class="alert alert-warning d-flex align-items-center justify-content-between flex-wrap gap-2 py-2">
                    <span>
                        <strong>@_gaps.Count topic@(_gaps.Count == 1 ? " has" : "s have") no cards</strong>
                        @if (_coverage.UncoveredCoreTopics > 0)
                        {
                            <span> — @_coverage.UncoveredCoreTopics of them core.</span>
                        }
                    </span>
                    <button class="btn btn-sm btn-primary" disabled="@_hasActiveJobs" @onclick="GenerateForGapsAsync">
                        ✨ Generate cards for @(Math.Min(_gaps.Count, MaxGapTopicsPerRun)) of them
                    </button>
                </div>
            }

            @if (_prerequisiteError is { } prereqError)
            {
                <div class="alert alert-warning py-2 small">@prereqError</div>
            }

            <div class="d-flex gap-3 mb-2 small text-muted">
                <span><strong>@_topics.Count(t => t.Importance == TopicImportance.Core)</strong> core</span>
                <span><strong>@_topics.Count(t => t.Importance == TopicImportance.Supporting)</strong> supporting</span>
                <span><strong>@_topics.Count(t => t.Importance == TopicImportance.Peripheral)</strong> peripheral</span>
                <span class="ms-auto btn-group btn-group-sm">
                    <button class="btn @(_mapAsList ? "btn-outline-secondary" : "btn-secondary")"
                            title="Topics laid out in the order you can learn them"
                            @onclick="() => _mapAsList = false">Path</button>
                    <button class="btn @(_mapAsList ? "btn-secondary" : "btn-outline-secondary")"
                            title="Every topic in one list, with its settings"
                            @onclick="() => _mapAsList = true">List</button>
                </span>
            </div>

            @* Deadlines belong on the map: the question is never "what does this course cover"
               in the abstract, it's "what do I need before the next thing that's due". *@
            @if (UpcomingAssignments.Any())
            {
                <div class="d-flex gap-2 flex-wrap mb-3">
                    @foreach (var assignment in UpcomingAssignments)
                    {
                        <button class="btn btn-sm @(_selectedAssignmentId == assignment.Id ? "btn-primary" : "btn-outline-primary")"
                                @onclick="() => _selectedAssignmentId = _selectedAssignmentId == assignment.Id ? null : assignment.Id">
                            <span class="md-content" dir="auto">📝 @MdInline(assignment.Title)</span>
                            <span class="badge text-bg-light border ms-1">@DueLabel(assignment.DueDate!.Value)</span>
                        </button>
                    }
                </div>
            }

            @if (_selectedAssignmentId is { } selectedId && _assignmentPlans.TryGetValue(selectedId, out var selectedPlan))
            {
                <div class="card mb-3 border-primary">
                    <div class="card-body py-2">
                        <StudyPlanView Plan="selectedPlan"
                                       Title="@(_materials.FirstOrDefault(m => m.Id == selectedId)?.Title ?? "")"
                                       AssignmentId="selectedId" />
                    </div>
                </div>
            }

            @if (!_mapAsList)
            {
                @if (!_progression.HasAnyEdges)
                {
                    <div class="alert alert-secondary py-2 small">
                        No dependencies recorded yet, so there's no order to show — every topic reads
                        as a starting point. Re-map the course to have them worked out, or set them
                        by hand from the <button class="btn btn-link p-0 align-baseline"
                                                 @onclick="() => _mapAsList = true">List</button> view.
                    </div>
                }

                @* dir="ltr": stages always flow left to right whatever the course's language, or
                   the drawn geometry stops matching the reading order. Individual names keep
                   dir="auto" so Hebrew still lays out correctly inside its card. *@
                <div class="topic-graph mb-3" dir="ltr" @ref="_graphRef">
                    <svg class="graph-edges" data-edges xmlns="http://www.w3.org/2000/svg" aria-hidden="true"></svg>
                    @foreach (var stage in _progression.Stages)
                    {
                        <div class="graph-stage">
                            <div class="graph-stage-label">Stage @(stage.Index + 1)</div>
                            @foreach (var topic in stage.Topics)
                            {
                                <div class="graph-node @NodeStateClass(topic)"
                                     data-topic="@topic.Id"
                                     data-requires="@RequiresAttribute(topic)">
                                    <div class="d-flex align-items-start gap-1">
                                        <span class="badge @ImportanceBadge(topic.Importance)">@topic.Importance.ToString()[..1]</span>
                                        <span class="fw-semibold small md-content" dir="auto">@MdInline(topic.Name)</span>
                                    </div>
                                    <div class="small mt-1">
                                        @if (CardsFor(topic.Id) is var n && n > 0)
                                        {
                                            <span class="text-muted">@n card@(n == 1 ? "" : "s")</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-warning">no cards</span>
                                        }
                                    </div>
                                </div>
                            }
                            @foreach (var milestone in MilestonesAfterStage(stage.Index))
                            {
                                <div class="graph-milestone @(_selectedAssignmentId == milestone.Id ? "selected" : "")"
                                     @onclick="() => _selectedAssignmentId = _selectedAssignmentId == milestone.Id ? null : milestone.Id">
                                    <div class="fw-semibold small md-content" dir="auto">📝 @MdInline(milestone.Title)</div>
                                    <div class="small">
                                        @if (milestone.SubmittedAt is { } handedIn)
                                        {
                                            <span>✓ submitted @handedIn.ToLocalTime().ToString("d MMM")</span>
                                        }
                                        else
                                        {
                                            <span>@DueLabel(milestone.DueDate!.Value)</span>
                                            @if (_assignmentPlans.TryGetValue(milestone.Id, out var milestonePlan))
                                            {
                                                <span> · @milestonePlan.TopicsReady/@milestonePlan.Items.Count ready</span>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
            <div class="list-group">
                @foreach (var topic in _topics)
                {
                    <div class="list-group-item">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                            <div class="flex-grow-1" style="min-width: 14rem;">
                                <span class="badge @ImportanceBadge(topic.Importance) me-1">@topic.Importance</span>
                                <span class="fw-semibold md-content" dir="auto">@MdInline(topic.Name)</span>
                                @if (CardsFor(topic.Id) is var cardCount)
                                {
                                    @if (cardCount > 0)
                                    {
                                        <span class="badge text-bg-light border ms-1"
                                              title="Cards that teach this topic">@cardCount card@(cardCount == 1 ? "" : "s")</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-warning ms-1" title="Nothing you study covers this yet">no cards</span>
                                    }
                                }
                                @if (topic.ImportancePinned)
                                {
                                    <span class="badge text-bg-light border ms-1" title="Re-mapping will not change this">📌 pinned</span>
                                }
                                @if (topic.PreviousImportance is { } was && was != topic.Importance)
                                {
                                    <span class="badge text-bg-info ms-1" title="Changed by a recent revision">
                                        @was → @topic.Importance
                                    </span>
                                }
                                @if (!string.IsNullOrWhiteSpace(topic.Summary))
                                {
                                    <div class="small text-muted map-md md-content" dir="auto">@Md(topic.Summary)</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(topic.ImportanceReason))
                                {
                                    <div class="small fst-italic map-md md-content" dir="auto">@Md(topic.ImportanceReason)</div>
                                }
                                @* What this topic builds on. Shown as text here; the map view
                                   draws the same edges as lines. *@
                                <div class="small mt-1">
                                    @if (topic.Prerequisites.Count > 0)
                                    {
                                        <span class="text-muted me-1" title="Learn these first">⟵ builds on</span>
                                        @foreach (var edge in topic.Prerequisites)
                                        {
                                            <span class="badge text-bg-light border me-1 md-content" dir="auto">
                                                @MdInline(TopicName(edge.PrerequisiteTopicId))
                                                @if (_editingPrerequisitesFor == topic.Id)
                                                {
                                                    <button class="btn btn-sm btn-link p-0 ms-1 align-baseline text-danger"
                                                            title="Remove this dependency"
                                                            @onclick="() => RemovePrerequisiteAsync(topic.Id, edge.PrerequisiteTopicId)">✕</button>
                                                }
                                            </span>
                                        }
                                    }
                                    @if (_editingPrerequisitesFor == topic.Id)
                                    {
                                        <select class="form-select form-select-sm d-inline-block mt-1" style="width: auto;"
                                                @onchange="e => AddPrerequisiteAsync(topic.Id, (string?)e.Value)">
                                            <option value="">Add a prerequisite…</option>
                                            @foreach (var other in _topics.Where(t => t.Id != topic.Id
                                                && topic.Prerequisites.All(p => p.PrerequisiteTopicId != t.Id)))
                                            {
                                                <option value="@other.Id">@other.Name</option>
                                            }
                                        </select>
                                        <button class="btn btn-sm btn-link p-0 ms-2 align-baseline"
                                                @onclick="() => _editingPrerequisitesFor = null">done</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-link p-0 align-baseline text-muted"
                                                title="Say what this topic builds on"
                                                @onclick="() => { _editingPrerequisitesFor = topic.Id; _prerequisiteError = null; }">
                                            @(topic.Prerequisites.Count > 0 ? "edit" : "⟵ set prerequisites")
                                        </button>
                                    }
                                </div>
                                @if (topic.Sources.Count > 0)
                                {
                                    <div class="small text-muted mt-1">
                                        @foreach (var source in topic.Sources.OrderByDescending(s => s.Mention).Take(4))
                                        {
                                            <span class="badge text-bg-light border me-1" dir="auto"
                                                  title="@source.Mention in this material">
                                                @(source.Mention == TopicMention.Assessed ? "📝 " : "")@(source.Material?.Title ?? "—")@(string.IsNullOrWhiteSpace(source.SourceReference) ? "" : $" {source.SourceReference}")
                                            </span>
                                        }
                                    </div>
                                }
                            </div>
                            <span class="text-nowrap d-flex gap-1 align-items-start">
                                <select class="form-select form-select-sm" style="width: auto;"
                                        title="Set importance yourself — this pins it"
                                        @onchange="e => SetTopicImportanceAsync(topic.Id, (string?)e.Value)">
                                    @foreach (var level in new[] { TopicImportance.Core, TopicImportance.Supporting, TopicImportance.Peripheral })
                                    {
                                        <option value="@level" selected="@(topic.Importance == level)">@level</option>
                                    }
                                </select>
                                <button class="btn btn-sm @(topic.ImportancePinned ? "btn-secondary" : "btn-outline-secondary")"
                                        title="@(topic.ImportancePinned ? "Unpin — let re-mapping adjust this" : "Pin — re-mapping will leave this alone")"
                                        @onclick="() => TogglePinAsync(topic.Id, !topic.ImportancePinned)">
                                    📌
                                </button>
                                <button class="btn btn-sm btn-outline-danger" title="Not relevant to me"
                                        @onclick="() => DismissTopicAsync(topic.Id)">
                                    ✕
                                </button>
                            </span>
                        </div>
                    </div>
                }
            </div>
            }
        }
        </div>
    }
    else if (_activeTab == "inbox")
    {
        @if (_suggestions.Count == 0)
        {
            <p class="text-muted">
                Nothing waiting for review. Generated cards land here before they enter a deck —
                nothing the AI writes is scheduled until you approve it.
            </p>
        }
        else
        {
            @* Accepting means creating a Card, and cards live in decks — so with no deck there
               is nowhere for these to go. Say that plainly and offer the fix inline, rather
               than greying the buttons out and leaving the reason invisible. *@
            @if (_deckStats.Count == 0)
            {
                <div class="alert alert-warning">
                    <strong>No deck to accept into.</strong>
                    Approved cards get filed into a deck, and this course doesn't have one yet.
                    <div class="input-group mt-2" style="max-width: 28rem;">
                        <input class="form-control" placeholder="Deck name, e.g. Maman 11"
                               @bind="_inboxNewDeckName" @bind:event="oninput" />
                        <button class="btn btn-primary"
                                disabled="@string.IsNullOrWhiteSpace(_inboxNewDeckName)"
                                @onclick="CreateDeckFromInboxAsync">
                            Create deck
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="d-flex align-items-end gap-2 mb-3 flex-wrap">
                    <div>
                        <label class="form-label mb-0 small">Accept into deck</label>
                        <select class="form-select" @bind="_inboxDeckId">
                            @foreach (var deck in _deckStats)
                            {
                                <option value="@deck.DeckId">@deck.Name</option>
                            }
                        </select>
                    </div>
                    <button class="btn btn-success" disabled="@(_inboxDeckId is null)"
                            @onclick="AcceptAllAsync">
                        Accept all @_suggestions.Count
                    </button>
                </div>
            }

            @if (_inboxError is not null)
            {
                <div class="alert alert-danger">@_inboxError</div>
            }

            <div @ref="_inboxRef">
                @foreach (var suggestion in _suggestions)
                {
                    <div class="card mb-2">
                        <div class="card-body">
                            @if (_editingSuggestionId == suggestion.Id)
                            {
                                <textarea class="form-control mb-2" rows="2" @bind="_editSuggestionFront"></textarea>
                                <textarea class="form-control mb-2" rows="3" @bind="_editSuggestionBack"></textarea>
                                <button class="btn btn-sm btn-success me-1" disabled="@(_inboxDeckId is null)"
                                        @onclick="() => AcceptAsync(suggestion.Id, true)">
                                    Save &amp; accept
                                </button>
                                <button class="btn btn-sm btn-secondary" @onclick="() => _editingSuggestionId = null">
                                    Cancel
                                </button>
                            }
                            else
                            {
                                <div class="fw-semibold suggestion-body md-content" dir="auto">
                                    @((MarkupString)MarkdownRenderer.ToHtml(suggestion.Front))
                                </div>
                                <hr class="my-2" />
                                <div class="text-muted suggestion-body md-content" dir="auto">
                                    @((MarkupString)MarkdownRenderer.ToHtml(suggestion.Back))
                                </div>

                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mt-2">
                                    <span class="small text-muted">
                                        @if (suggestion.SourceMaterial is { } src)
                                        {
                                            <span dir="auto">@src.Title</span>
                                        }
                                        @if (suggestion.SourceReference is { Length: > 0 } reference)
                                        {
                                            <span class="badge text-bg-light border ms-1" dir="auto">@reference</span>
                                        }
                                        @if (suggestion.Rationale is { Length: > 0 } why)
                                        {
                                            <span class="ms-1 fst-italic" dir="auto">— @why</span>
                                        }
                                    </span>
                                    <span class="text-nowrap">
                                        <button class="btn btn-sm btn-success me-1" disabled="@(_inboxDeckId is null)"
                                                title="@(_inboxDeckId is null ? "Create a deck first — accepted cards have to be filed somewhere" : "Accept into the selected deck")"
                                                @onclick="() => AcceptAsync(suggestion.Id, false)">
                                            ✓ Accept
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary me-1"
                                                @onclick="() => StartSuggestionEdit(suggestion)">
                                            ✏ Edit
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => RejectAsync(suggestion.Id)">
                                            ✕ Reject
                                        </button>
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        @if (_editingNotes)
        {
            <textarea class="form-control mb-2 font-monospace" rows="14"
                      placeholder="Markdown notes for this course…" @bind="_notesDraft"></textarea>
            <button class="btn btn-primary me-2" @onclick="SaveNotesAsync">Save notes</button>
            <button class="btn btn-secondary" @onclick="() => _editingNotes = false">Cancel</button>
        }
        else
        {
            @if (string.IsNullOrWhiteSpace(_course.NotesMarkdown))
            {
                <p class="text-muted">No notes yet.</p>
            }
            else
            {
                <div class="border rounded p-3 mb-2 notes-rendered md-content" dir="auto" @ref="_notesRef">
                    @((MarkupString)MarkdownRenderer.ToHtml(_course.NotesMarkdown))
                </div>
            }
            <button class="btn btn-outline-primary" @onclick="StartNotesEdit">✏ Edit notes</button>
        }
    }
}

