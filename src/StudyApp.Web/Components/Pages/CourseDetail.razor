    private void SetWeight(MaterialKind kind, string? value)
    {
        if (!int.TryParse(value, out var weight))
            return;
        var target = _weights.FirstOrDefault(w => w.Kind == kind);
        if (target is not null)
            target.Weight = Math.Clamp(weight, 0, 100);
        _weightsSaved = false;
    }

    private void ResetWeights()
    {
        _weights = AssessmentWeight.Defaults();
        _weightsSaved = false;
    }

    private async Task SaveWeightsAsync()
    {
        await CourseService.SaveAssessmentWeightsAsync(Id, _weights);
        _weightsSaved = true;
